{
  "name": "twinstack-site",
  "version": "1.0.0",
  "private": true,
  "description": "TwinStack Solutions website: a zero-dependency static site generator with Claude-managed content automation.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "css": "tailwindcss --input styles/main.css --output assets/css/main.css --minify",
    "css:watch": "tailwindcss --input styles/main.css --output assets/css/main.css --watch",
    "check": "node scripts/build.js && node scripts/check.js",
    "new": "node scripts/new.js",
    "blog:generate": "node scripts/generate-post.js",
    "blog:preview": "node scripts/generate-post.js --dry-run",
    "blog:publish": "node scripts/generate-post.js --publish"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  }
}
